{
  "name": "vyntra-omni",
  "version": "0.0.0",
  "private": true,
  "description": "Fundação técnica do Omnichannel V1.",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "ambiente:estado": "node scripts/ambiente-local.mjs estado",
    "ambiente:configuracao-mobile": "node scripts/ambiente-local.mjs configuracao-mobile",
    "ambiente:parar": "node scripts/ambiente-local.mjs parar",
    "ambiente:preparar": "node scripts/ambiente-local.mjs preparar",
    "ambiente:subir": "node scripts/ambiente-local.mjs subir",
    "ambiente:validar": "node scripts/ambiente-local.mjs validar",
    "build": "node scripts/executar-turbo.mjs build",
    "dev": "node scripts/executar-turbo.mjs dev",
    "gerar:contratos": "node scripts/gerar-contratos.mjs",
    "lint": "node scripts/executar-turbo.mjs lint && eslint scripts tests --max-warnings 0",
    "staging:estado": "node scripts/ambiente-staging.mjs estado",
    "staging:configuracao-mobile": "node scripts/ambiente-staging.mjs configuracao-mobile",
    "staging:parar": "node scripts/ambiente-staging.mjs parar",
    "staging:preparar": "node scripts/ambiente-staging.mjs preparar",
    "staging:preparar-administrador": "node scripts/ambiente-staging.mjs preparar-administrador",
    "staging:aceitar-pr097": "node scripts/aceitar-pr097-staging.mjs",
    "staging:smoke": "node scripts/ambiente-staging.mjs smoke",
    "staging:subir": "node scripts/ambiente-staging.mjs subir",
    "staging:validar": "node scripts/ambiente-staging.mjs validar",
    "test": "node scripts/verificar-contratos.mjs && node scripts/executar-turbo.mjs test && node --test \"tests/*.test.mjs\"",
    "typecheck": "node scripts/executar-turbo.mjs typecheck",
    "verificar:dependencias": "node scripts/verificar-dependencias.mjs",
    "verificar:contratos": "node scripts/verificar-contratos.mjs",
    "verificar:expo": "pnpm --filter @vyntra/mobile verificar:expo",
    "verificar:segredos": "node scripts/verificar-segredos.mjs"
  },
  "devDependencies": {
    "eslint": "10.9.1",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "yaml": "2.9.0"
  }
}
