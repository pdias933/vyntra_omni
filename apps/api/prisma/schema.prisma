generator client {
  provider     = "prisma-client"
  output       = "../src/gerado/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum OrigemAuditoria {
  USUARIO
  FLUXO
  SISTEMA
  INTEGRACAO

  @@map("origem_auditoria")
}

enum ClassificacaoDadosEvento {
  OPERACIONAL
  DADO_PESSOAL
  DADO_SENSIVEL

  @@map("classificacao_dados_evento")
}

enum EstadoItemCaixaSaida {
  PENDENTE
  PROCESSADO

  @@map("estado_item_caixa_saida")
}

enum EstadoOperacaoRecuperavel {
  PENDENTE
  EM_EXECUCAO
  AGUARDANDO_NOVA_TENTATIVA
  RESULTADO_INCERTO
  EM_RECONCILIACAO
  CONCLUIDA
  FALHA_DEFINITIVA

  @@map("estado_operacao_recuperavel")
}

enum TipoTentativaOperacao {
  EXECUCAO
  RECONCILIACAO

  @@map("tipo_tentativa_operacao")
}

enum ResultadoTentativaOperacao {
  EM_ANDAMENTO
  SUCESSO
  FALHA_TEMPORARIA
  RESULTADO_INCERTO
  EFEITO_AUSENTE
  FALHA_DEFINITIVA

  @@map("resultado_tentativa_operacao")
}

enum EstadoUsuario {
  ATIVO
  INATIVO

  @@map("estado_usuario")
}

enum EstadoDisponibilidadeUsuario {
  DISPONIVEL
  INDISPONIVEL

  @@map("estado_disponibilidade_usuario")
}

enum PapelBase {
  ADMINISTRADOR
  SUPERVISOR
  ATENDENTE

  @@map("papel_base")
}

enum EstadoPerfilAcesso {
  ATIVO
  INATIVO

  @@map("estado_perfil_acesso")
}

enum EfeitoPermissaoPerfil {
  CONCEDER
  NEGAR

  @@map("efeito_permissao_perfil")
}

enum CodigoPermissao {
  VISUALIZAR_FILA
  RESGATAR_ATENDIMENTO
  TRANSFERIR_ATENDIMENTO
  RECEBER_TRANSFERENCIA
  ENCERRAR_ATENDIMENTO
  REABRIR_ATENDIMENTO
  ASSUMIR_ATENDIMENTO
  ADICIONAR_NOTA_INTERNA
  VISUALIZAR_NOTA_INTERNA
  CONSULTAR_CLIENTE
  VINCULAR_CLIENTE
  ALTERAR_CONTEXTO_CLIENTE
  CONSULTAR_CONTRATO
  CONSULTAR_FINANCEIRO
  ENVIAR_FATURA
  VERIFICAR_DESBLOQUEIO_CONFIANCA
  EXECUTAR_DESBLOQUEIO_CONFIANCA
  CONSULTAR_SESSAO_ACESSO
  DESCONECTAR_SESSAO_ACESSO
  CRIAR_ORDEM_SERVICO
  SOLICITAR_FORMULARIO_WHATSAPP
  VISUALIZAR_FLUXO
  EDITAR_FLUXO
  TESTAR_FLUXO
  PUBLICAR_FLUXO
  REVERTER_FLUXO
  VISUALIZAR_HISTORICO_TRANSVERSAL
  VISUALIZAR_NOTAS_TRANSVERSAIS
  VISUALIZAR_DADO_SENSIVEL
  EXPORTAR_HISTORICO
  ADMINISTRAR_USUARIOS
  ADMINISTRAR_FILAS
  ADMINISTRAR_INTEGRACOES
  ADMINISTRAR_RELEASES
  ALTERAR_DISPONIBILIDADE_PROPRIA
  ALTERAR_DISPONIBILIDADE_USUARIO

  @@map("codigo_permissao")
}

enum EstadoFila {
  ATIVA
  INATIVA

  @@map("estado_fila")
}

enum EstadoAtendimento {
  AGUARDANDO
  EM_ATENDIMENTO
  ENCERRADO_REABRIVEL
  ENCERRADO

  @@map("estado_atendimento")
}

enum ModoAtendimento {
  BOT
  FILA_HUMANA
  HUMANO

  @@map("modo_atendimento")
}

enum MotivoEsperaAtendimento {
  PROCESSANDO_BOT
  AGUARDANDO_HUMANO
  FORA_DO_HORARIO
  AGUARDANDO_CLIENTE
  NENHUM

  @@map("motivo_espera_atendimento")
}

enum OrigemEncerramentoAtendimento {
  USUARIO
  FLUXO

  @@map("origem_encerramento_atendimento")
}

enum EstadoProtocoloErp {
  PENDENTE
  OFICIAL

  @@map("estado_protocolo_erp")
}

enum EstadoAcessoFila {
  ATIVO
  REVOGADO

  @@map("estado_acesso_fila")
}

enum EstadoCredencialSenha {
  ATIVA
  REVOGADA

  @@map("estado_credencial_senha")
}

enum EstadoSessaoWeb {
  ATIVA
  REVOGADA

  @@map("estado_sessao_web")
}

enum ResultadoTentativaLoginWeb {
  SUCESSO
  FALHA
  BLOQUEADA

  @@map("resultado_tentativa_login_web")
}

enum PlataformaMobile {
  IOS
  ANDROID

  @@map("plataforma_mobile")
}

enum EstadoDispositivoMobile {
  ATIVO
  REVOGADO

  @@map("estado_dispositivo_mobile")
}

enum EstadoSessaoMobile {
  ATIVA
  REVOGADA

  @@map("estado_sessao_mobile")
}

enum ResultadoTentativaLoginMobile {
  SUCESSO
  FALHA
  BLOQUEADA

  @@map("resultado_tentativa_login_mobile")
}

enum EstadoPareamentoQr {
  AGUARDANDO_RESGATE
  AGUARDANDO_CONFIRMACAO
  CONFIRMADO
  CONCLUIDO
  CANCELADO
  EXPIRADO

  @@map("estado_pareamento_qr")
}

enum ResultadoTentativaResgateQr {
  SUCESSO
  FALHA
  BLOQUEADA

  @@map("resultado_tentativa_resgate_qr")
}

enum EstadoControleRecurso {
  ATIVADO
  DESATIVADO

  @@map("estado_controle_recurso")
}

enum EstadoContaWhatsApp {
  ATIVA
  INATIVA

  @@map("estado_conta_whatsapp")
}

enum EstadoContato {
  NORMAL
  BLOQUEADO

  @@map("estado_contato")
}

enum ResultadoAlteracaoIdentidadeWhatsApp {
  PRESERVADA
  SEPARADA_INCERTA

  @@map("resultado_alteracao_identidade_whatsapp")
}

enum TipoVinculoCliente {
  VERIFICADO
  MANUAL
  TEMPORARIO

  @@map("tipo_vinculo_cliente")
}

enum OrigemContextoAtendimento {
  IDENTIFICACAO
  USUARIO
  FLUXO
  SISTEMA

  @@map("origem_contexto_atendimento")
}

enum OrigemSnapshotCliente {
  INTEGRACAO_ERP

  @@map("origem_snapshot_cliente")
}

model RegistroAuditoria {
  id                         String          @id @db.Uuid
  tipoEvento                 String          @map("tipo_evento") @db.VarChar(100)
  origem                     OrigemAuditoria
  usuarioId                  String?         @map("usuario_id") @db.Uuid
  fluxoId                    String?         @map("fluxo_id") @db.Uuid
  versaoFluxoId              String?         @map("versao_fluxo_id") @db.Uuid
  atendimentoId              String?         @map("atendimento_id") @db.Uuid
  contatoId                  String?         @map("contato_id") @db.Uuid
  filaId                     String?         @map("fila_id") @db.Uuid
  acao                       String          @db.VarChar(100)
  entidadeTipo               String?         @map("entidade_tipo") @db.VarChar(100)
  entidadeId                 String?         @map("entidade_id") @db.Uuid
  dadosAnterioresSanitizados Json?           @map("dados_anteriores_sanitizados")
  dadosNovosSanitizados      Json?           @map("dados_novos_sanitizados")
  enderecoIp                 String?         @map("endereco_ip") @db.Inet
  dispositivoId              String?         @map("dispositivo_id") @db.Uuid
  sessaoId                   String?         @map("sessao_id") @db.Uuid
  correlacaoId               String          @map("correlacao_id") @db.Uuid
  criadoEm                   DateTime        @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([criadoEm], map: "registro_auditoria_criado_em_idx")
  @@index([usuarioId, criadoEm], map: "registro_auditoria_usuario_criado_em_idx")
  @@index([atendimentoId, criadoEm], map: "registro_auditoria_atendimento_criado_em_idx")
  @@index([entidadeTipo, entidadeId, criadoEm], map: "registro_auditoria_entidade_criado_em_idx")
  @@map("registro_auditoria")
}

model EventoDominio {
  id                         String                    @id @db.Uuid
  sequenciaEvento            BigInt                    @unique @default(autoincrement()) @map("sequencia_evento")
  tipo                       String                    @db.VarChar(100)
  entidadeTipo               String                    @map("entidade_tipo") @db.VarChar(100)
  entidadeId                 String                    @map("entidade_id") @db.Uuid
  atendimentoId              String?                   @map("atendimento_id") @db.Uuid
  conversaId                 String?                   @map("conversa_id") @db.Uuid
  usuarioAtorId              String?                   @map("usuario_ator_id") @db.Uuid
  classificacaoDados         ClassificacaoDadosEvento @map("classificacao_dados")
  dadosProtegidosMinimizados Json                      @map("dados_protegidos_minimizados")
  criadoEm                   DateTime                  @default(now()) @map("criado_em") @db.Timestamptz(6)
  itensCaixaSaida            ItemCaixaSaida[]

  @@index([criadoEm], map: "evento_dominio_criado_em_idx")
  @@index([entidadeTipo, entidadeId, sequenciaEvento], map: "evento_dominio_entidade_sequencia_idx")
  @@index([atendimentoId, sequenciaEvento], map: "evento_dominio_atendimento_sequencia_idx")
  @@index([conversaId, sequenciaEvento], map: "evento_dominio_conversa_sequencia_idx")
  @@map("evento_dominio")
}

model ItemCaixaSaida {
  id                         String               @id @db.Uuid
  eventoDominioId            String               @map("evento_dominio_id") @db.Uuid
  tipo                       String               @db.VarChar(100)
  destino                    String               @db.VarChar(100)
  estado                     EstadoItemCaixaSaida @default(PENDENTE)
  dadosProtegidosMinimizados Json                 @map("dados_protegidos_minimizados")
  disponivelEm               DateTime             @default(now()) @map("disponivel_em") @db.Timestamptz(6)
  criadoEm                   DateTime             @default(now()) @map("criado_em") @db.Timestamptz(6)
  processadoEm               DateTime?            @map("processado_em") @db.Timestamptz(6)
  eventoDominio              EventoDominio        @relation(fields: [eventoDominioId], references: [id], onDelete: Restrict)

  @@index([estado, disponivelEm, criadoEm], map: "item_caixa_saida_pendente_idx")
  @@index([eventoDominioId], map: "item_caixa_saida_evento_idx")
  @@map("item_caixa_saida")
}

model RegistroIdempotencia {
  id                       String               @id @db.Uuid
  escopoTipo               String               @map("escopo_tipo") @db.VarChar(100)
  escopoId                 String               @map("escopo_id") @db.Uuid
  chaveHash                String               @map("chave_hash") @db.Char(64)
  assinaturaRequisicaoHash String               @map("assinatura_requisicao_hash") @db.Char(64)
  criadoEm                 DateTime             @default(now()) @map("criado_em") @db.Timestamptz(6)
  operacao                 OperacaoRecuperavel?

  @@unique([escopoTipo, escopoId, chaveHash], map: "registro_idempotencia_escopo_chave_key")
  @@index([criadoEm], map: "registro_idempotencia_criado_em_idx")
  @@map("registro_idempotencia")
}

model OperacaoRecuperavel {
  id                         String                    @id @db.Uuid
  registroIdempotenciaId     String                    @unique @map("registro_idempotencia_id") @db.Uuid
  tipo                       String                    @db.VarChar(100)
  entidadeTipo               String?                   @map("entidade_tipo") @db.VarChar(100)
  entidadeId                 String?                   @map("entidade_id") @db.Uuid
  estado                     EstadoOperacaoRecuperavel @default(PENDENTE)
  tentativas                 Int                       @default(0)
  versao                     Int                       @default(0)
  concessaoTokenHash         String?                   @map("concessao_token_hash") @db.Char(64)
  concessaoAte               DateTime?                 @map("concessao_ate") @db.Timestamptz(6)
  proximaAcaoEm              DateTime?                 @default(now()) @map("proxima_acao_em") @db.Timestamptz(6)
  codigoUltimoErro           String?                   @map("codigo_ultimo_erro") @db.VarChar(100)
  resultadoProtegido         Json?                     @map("resultado_protegido")
  criadoEm                   DateTime                  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm               DateTime                  @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  concluidoEm                DateTime?                 @map("concluido_em") @db.Timestamptz(6)
  registroIdempotencia       RegistroIdempotencia      @relation(fields: [registroIdempotenciaId], references: [id], onDelete: Restrict)
  historicoTentativas        TentativaOperacao[]

  @@index([estado, proximaAcaoEm, criadoEm], map: "operacao_recuperavel_pendente_idx")
  @@index([entidadeTipo, entidadeId, criadoEm], map: "operacao_recuperavel_entidade_idx")
  @@map("operacao_recuperavel")
}

model TentativaOperacao {
  id                 String                     @id @db.Uuid
  operacaoId         String                     @map("operacao_id") @db.Uuid
  numero             Int
  tipo               TipoTentativaOperacao
  resultado          ResultadoTentativaOperacao @default(EM_ANDAMENTO)
  concessaoTokenHash String                     @map("concessao_token_hash") @db.Char(64)
  codigoResultado    String?                    @map("codigo_resultado") @db.VarChar(100)
  dadosProtegidos    Json?                      @map("dados_protegidos")
  iniciadaEm         DateTime                   @default(now()) @map("iniciada_em") @db.Timestamptz(6)
  encerradaEm        DateTime?                  @map("encerrada_em") @db.Timestamptz(6)
  operacao           OperacaoRecuperavel        @relation(fields: [operacaoId], references: [id], onDelete: Restrict)

  @@unique([operacaoId, numero], map: "tentativa_operacao_numero_key")
  @@index([resultado, iniciadaEm], map: "tentativa_operacao_resultado_idx")
  @@map("tentativa_operacao")
}

model Usuario {
  id            String        @id @db.Uuid
  nomeExibicao  String        @map("nome_exibicao") @db.VarChar(160)
  estado        EstadoUsuario @default(ATIVO)
  perfilId      String?       @map("perfil_id") @db.Uuid
  inativadoEm   DateTime?     @map("inativado_em") @db.Timestamptz(6)
  criadoEm      DateTime      @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime      @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  perfil        PerfilAcesso? @relation(fields: [perfilId], references: [id], onDelete: Restrict)
  acessosFila   AcessoUsuarioFila[]
  credencialSenha CredencialSenha?
  sessoesWeb    SessaoWeb[]
  dispositivosMobile DispositivoMobile[]
  sessoesMobile SessaoMobile[]
  pareamentosQr PareamentoQr[]
  liberacoesControlesRecurso LiberacaoControleRecursoUsuario[]
  vinculosClienteVerificados VinculoCliente[] @relation("UsuarioVerificacaoVinculoCliente")
  contextosAtendimentoAlterados ContextoAtendimento[] @relation("UsuarioAlteracaoContextoAtendimento")
  atendimentosResponsaveis Atendimento[] @relation("UsuarioResponsavelAtendimento")
  disponibilidade DisponibilidadeUsuario? @relation("UsuarioDisponibilidade")
  disponibilidadesAlteradas DisponibilidadeUsuario[] @relation("UsuarioAlteracaoDisponibilidade")

  @@index([estado, nomeExibicao], map: "usuario_estado_nome_idx")
  @@index([perfilId], map: "usuario_perfil_idx")
  @@map("usuario")
}

model DisponibilidadeUsuario {
  usuarioId            String                       @id @map("usuario_id") @db.Uuid
  estado               EstadoDisponibilidadeUsuario @default(INDISPONIVEL)
  alteradoEm           DateTime                     @map("alterado_em") @db.Timestamptz(6)
  alteradoPorUsuarioId String                       @map("alterado_por_usuario_id") @db.Uuid
  versao               Int                          @default(1)
  usuario              Usuario                      @relation("UsuarioDisponibilidade", fields: [usuarioId], references: [id], onDelete: Restrict)
  alteradoPorUsuario   Usuario                      @relation("UsuarioAlteracaoDisponibilidade", fields: [alteradoPorUsuarioId], references: [id], onDelete: Restrict)

  @@index([estado, alteradoEm, usuarioId], map: "disponibilidade_usuario_estado_idx")
  @@index([alteradoPorUsuarioId, alteradoEm], map: "disponibilidade_usuario_alterador_idx")
  @@map("disponibilidade_usuario")
}

model DispositivoMobile {
  id                         String                    @id @db.Uuid
  usuarioId                  String                    @map("usuario_id") @db.Uuid
  identificadorInstalacaoHash String                  @map("identificador_instalacao_hash") @db.Char(64)
  segredoVinculoHash         String                    @map("segredo_vinculo_hash") @db.Char(64)
  estado                     EstadoDispositivoMobile  @default(ATIVO)
  plataforma                 PlataformaMobile
  modeloSanitizado           String?                   @map("modelo_sanitizado") @db.VarChar(120)
  versaoAplicativo           String                    @map("versao_aplicativo") @db.VarChar(40)
  ultimoAcessoEm             DateTime                  @default(now()) @map("ultimo_acesso_em") @db.Timestamptz(6)
  revogadoEm                 DateTime?                 @map("revogado_em") @db.Timestamptz(6)
  motivoRevogacao            String?                   @map("motivo_revogacao") @db.VarChar(80)
  criadoEm                   DateTime                  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm               DateTime                  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  usuario                    Usuario                   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  sessoes                    SessaoMobile[]

  @@unique([id, usuarioId], map: "dispositivo_mobile_id_usuario_key")
  @@unique([usuarioId, identificadorInstalacaoHash], map: "dispositivo_mobile_usuario_instalacao_key")
  @@index([usuarioId, estado, ultimoAcessoEm], map: "dispositivo_mobile_usuario_estado_acesso_idx")
  @@map("dispositivo_mobile")
}

model SessaoMobile {
  id                    String              @id @db.Uuid
  usuarioId             String              @map("usuario_id") @db.Uuid
  dispositivoId         String              @map("dispositivo_id") @db.Uuid
  tokenAcessoHash       String              @unique @map("token_acesso_hash") @db.Char(64)
  tokenRefreshHash      String              @unique @map("token_refresh_hash") @db.Char(64)
  estado                EstadoSessaoMobile  @default(ATIVA)
  versao                Int                 @default(0)
  autenticadaEm         DateTime            @default(now()) @map("autenticada_em") @db.Timestamptz(6)
  acessoExpiraEm        DateTime            @map("acesso_expira_em") @db.Timestamptz(6)
  refreshExpiraEm       DateTime            @map("refresh_expira_em") @db.Timestamptz(6)
  rotacionadaEm         DateTime?           @map("rotacionada_em") @db.Timestamptz(6)
  revogadaEm            DateTime?           @map("revogada_em") @db.Timestamptz(6)
  motivoRevogacao       String?             @map("motivo_revogacao") @db.VarChar(80)
  criadoEm              DateTime            @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm          DateTime            @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  usuario               Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  dispositivo           DispositivoMobile   @relation(fields: [dispositivoId, usuarioId], references: [id, usuarioId], onDelete: Restrict)
  tokensRefreshUsados   TokenRefreshMobileUsado[]

  @@index([usuarioId, estado, refreshExpiraEm], map: "sessao_mobile_usuario_estado_refresh_idx")
  @@index([dispositivoId, estado, refreshExpiraEm], map: "sessao_mobile_dispositivo_estado_refresh_idx")
  @@map("sessao_mobile")
}

model TokenRefreshMobileUsado {
  tokenHash   String        @id @map("token_hash") @db.Char(64)
  sessaoId    String        @map("sessao_id") @db.Uuid
  usadoEm     DateTime      @default(now()) @map("usado_em") @db.Timestamptz(6)
  sessao      SessaoMobile  @relation(fields: [sessaoId], references: [id], onDelete: Restrict)

  @@index([sessaoId, usadoEm], map: "token_refresh_mobile_usado_sessao_idx")
  @@map("token_refresh_mobile_usado")
}

model TentativaLoginMobile {
  id                            String                          @id @db.Uuid
  identificadorHash             String                          @map("identificador_hash") @db.Char(64)
  enderecoIp                    String                          @map("endereco_ip") @db.Inet
  identificadorInstalacaoHash   String                          @map("identificador_instalacao_hash") @db.Char(64)
  resultado                     ResultadoTentativaLoginMobile
  criadoEm                      DateTime                        @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([identificadorHash, enderecoIp, identificadorInstalacaoHash, criadoEm], map: "tentativa_login_mobile_identificador_ip_dispositivo_idx")
  @@index([enderecoIp, criadoEm], map: "tentativa_login_mobile_ip_idx")
  @@map("tentativa_login_mobile")
}

model CredencialSenha {
  usuarioId              String                 @id @map("usuario_id") @db.Uuid
  identificadorNormalizado String               @unique @map("identificador_normalizado") @db.VarChar(120)
  senhaHash              String                 @map("senha_hash") @db.VarChar(255)
  estado                 EstadoCredencialSenha  @default(ATIVA)
  senhaAlteradaEm        DateTime               @default(now()) @map("senha_alterada_em") @db.Timestamptz(6)
  revogadaEm             DateTime?              @map("revogada_em") @db.Timestamptz(6)
  criadoEm               DateTime               @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm           DateTime               @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  usuario                Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([estado, identificadorNormalizado], map: "credencial_senha_estado_identificador_idx")
  @@map("credencial_senha")
}

model SessaoWeb {
  id                 String           @id @db.Uuid
  usuarioId          String           @map("usuario_id") @db.Uuid
  tokenHash          String           @unique @map("token_hash") @db.Char(64)
  csrfHash           String           @map("csrf_hash") @db.Char(64)
  estado             EstadoSessaoWeb  @default(ATIVA)
  versao             Int              @default(0)
  enderecoIp         String           @map("endereco_ip") @db.Inet
  agenteUsuarioHash  String           @map("agente_usuario_hash") @db.Char(64)
  autenticadaEm      DateTime         @default(now()) @map("autenticada_em") @db.Timestamptz(6)
  ultimaAtividadeEm  DateTime         @default(now()) @map("ultima_atividade_em") @db.Timestamptz(6)
  expiraEm           DateTime         @map("expira_em") @db.Timestamptz(6)
  rotacionadaEm      DateTime?        @map("rotacionada_em") @db.Timestamptz(6)
  revogadaEm         DateTime?        @map("revogada_em") @db.Timestamptz(6)
  motivoRevogacao    String?          @map("motivo_revogacao") @db.VarChar(80)
