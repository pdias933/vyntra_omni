model ContextoAtendimento {
  atendimentoId             String                      @id @map("atendimento_id") @db.Uuid
  contatoId                 String                      @map("contato_id") @db.Uuid
  vinculoClienteId          String                      @map("vinculo_cliente_id") @db.Uuid
  vinculoContratoId         String?                     @map("vinculo_contrato_id") @db.Uuid
  clienteExternoAtivoId     String                      @map("cliente_externo_ativo_id") @db.VarChar(256)
  contratoExternoAtivoId    String?                     @map("contrato_externo_ativo_id") @db.VarChar(256)
  origem                    OrigemContextoAtendimento   @map("origem_contexto")
  versao                    Int                         @default(1)
  alteradoEm                DateTime                    @map("alterado_em") @db.Timestamptz(6)
  alteradoPorUsuarioId      String?                     @map("alterado_por_usuario_id") @db.Uuid
  contato                   Contato                     @relation(fields: [contatoId], references: [id], onDelete: Restrict)
  vinculoCliente            VinculoCliente              @relation(fields: [vinculoClienteId, contatoId], references: [id, contatoId], onDelete: Restrict)
  vinculoContrato           VinculoContrato?            @relation(fields: [vinculoContratoId, vinculoClienteId], references: [id, vinculoClienteId], onDelete: Restrict)
  alteradoPorUsuario        Usuario?                    @relation("UsuarioAlteracaoContextoAtendimento", fields: [alteradoPorUsuarioId], references: [id], onDelete: Restrict)
  atendimento               Atendimento                 @relation(fields: [atendimentoId], references: [id], onDelete: Restrict)

  @@index([contatoId, alteradoEm, atendimentoId], map: "contexto_atendimento_contato_idx")
  @@index([vinculoClienteId, vinculoContratoId], map: "contexto_atendimento_vinculos_idx")
  @@map("contexto_atendimento")
}

model LiberacaoControleRecursoUsuario {
  controleRecursoId String           @map("controle_recurso_id") @db.Uuid
  usuarioId         String           @map("usuario_id") @db.Uuid
  criadoEm          DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  controleRecurso   ControleRecurso  @relation(fields: [controleRecursoId], references: [id], onDelete: Restrict)
  usuario           Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@id([controleRecursoId, usuarioId])
  @@index([usuarioId, controleRecursoId], map: "liberacao_controle_recurso_usuario_idx")
  @@map("liberacao_controle_recurso_usuario")
}

model LiberacaoControleRecursoFila {
  controleRecursoId String           @map("controle_recurso_id") @db.Uuid
  filaId            String           @map("fila_id") @db.Uuid
  criadoEm          DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  controleRecurso   ControleRecurso  @relation(fields: [controleRecursoId], references: [id], onDelete: Restrict)
  fila              Fila             @relation(fields: [filaId], references: [id], onDelete: Restrict)

  @@id([controleRecursoId, filaId])
  @@index([filaId, controleRecursoId], map: "liberacao_controle_recurso_fila_idx")
  @@map("liberacao_controle_recurso_fila")
}

model PoliticaVersaoMobile {
  plataforma          PlataformaMobile @id
  versaoMinima        String           @default("0.0.0") @map("versao_minima") @db.VarChar(40)
  versaoRecomendada   String           @default("0.0.0") @map("versao_recomendada") @db.VarChar(40)
  mensagem            String?          @db.VarChar(240)
  urlLoja             String?          @map("url_loja") @db.VarChar(500)
  versao              Int              @default(0)
  atualizadoEm        DateTime         @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("politica_versao_mobile")
}
