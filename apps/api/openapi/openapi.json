{
  "openapi": "3.1.0",
  "paths": {
    "/api/v1": {
      "get": {
        "operationId": "obterInformacoesApi",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InformacoesApiDto"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroCanonicoDto"
                }
              }
            }
          }
        },
        "summary": "Obtém a identidade e a versão pública da API.",
        "tags": [
          "sistema"
        ]
      }
    },
    "/api/v1/saude/vivo": {
      "get": {
        "operationId": "verificarProcessoVivo",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstadoSaudeDto"
                }
              }
            }
          }
        },
        "summary": "Informa se o processo da API está vivo.",
        "tags": [
          "saude"
        ]
      }
    },
    "/api/v1/saude/pronto": {
      "get": {
        "operationId": "verificarAplicacaoPronta",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstadoSaudeDto"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroCanonicoDto"
                }
              }
            }
          }
        },
        "summary": "Informa se a API pode receber tráfego.",
        "tags": [
          "saude"
        ]
      }
    },
    "/api/v1/autenticacao/web/entrar": {
      "post": {
        "operationId": "entrarSessaoWeb",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntradaLoginWebDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoWebDto"
                }
              }
            }
          }
        },
        "summary": "Autentica e cria uma sessão web",
        "tags": [
          "autenticacao"
        ]
      }
    },
    "/api/v1/autenticacao/web/sessao": {
      "get": {
        "operationId": "obterSessaoWeb",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoWebDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessaoWeb": []
          }
        ],
        "summary": "Obtém a sessão web atual",
        "tags": [
          "autenticacao"
        ]
      }
    },
    "/api/v1/autenticacao/web/rotacionar": {
      "post": {
        "operationId": "rotacionarSessaoWeb",
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoWebDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessaoWeb": []
          }
        ],
        "summary": "Rotaciona os segredos da sessão web",
        "tags": [
          "autenticacao"
        ]
      }
    },
    "/api/v1/autenticacao/web/sair": {
      "post": {
        "operationId": "sairSessaoWeb",
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "sessaoWeb": []
          }
        ],
        "summary": "Revoga a sessão web atual",
        "tags": [
          "autenticacao"
        ]
      }
    }
  },
  "info": {
    "title": "API Vyntra Omnichannel",
    "description": "Contrato público e versionado do Omnichannel V1.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "sessaoWeb": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-vyntra_sessao"
      }
    },
    "schemas": {
      "ErroCanonicoDto": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "example": "RECURSO_NAO_ENCONTRADO"
          },
          "mensagem": {
            "type": "string",
            "example": "O recurso solicitado não foi encontrado."
          },
          "correlacao_id": {
            "type": "string",
            "example": "7fe3cc48-98bc-4b36-9fe7-36de7c1ac882"
          }
        },
        "required": [
          "codigo",
          "mensagem",
          "correlacao_id"
        ]
      },
      "InformacoesApiDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "Vyntra Omnichannel"
          },
          "versao_api": {
            "type": "string",
            "example": "v1"
          }
        },
        "required": [
          "nome",
          "versao_api"
        ]
      },
      "EstadoSaudeDto": {
        "type": "object",
        "properties": {
          "estado": {
            "type": "string",
            "enum": [
              "VIVO",
              "PRONTO"
            ],
            "example": "PRONTO"
          }
        },
        "required": [
          "estado"
        ]
      },
      "EntradaLoginWebDto": {
        "type": "object",
        "properties": {
          "identificador": {
            "type": "string",
            "example": "maria.silva",
            "maxLength": 120,
            "minLength": 3
          },
          "senha": {
            "type": "string",
            "example": "uma senha longa e privada",
            "maxLength": 128,
            "minLength": 12
          }
        },
        "required": [
          "identificador",
          "senha"
        ]
      },
      "SessaoWebDto": {
        "type": "object",
        "properties": {
          "sessao_id": {
            "type": "string",
            "format": "uuid"
          },
          "usuario_id": {
            "type": "string",
            "format": "uuid"
          },
          "nome_exibicao": {
            "type": "string",
            "example": "Maria Silva"
          },
          "expira_em": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "sessao_id",
          "usuario_id",
          "nome_exibicao",
          "expira_em"
        ]
      }
    }
  }
}
