        "tags": [
          "sistema"
        ]
      }
    },
    "/api/v1/saude/vivo": {
      "get": {
        "operationId": "verificarProcessoVivo",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstadoSaudeDto"
                }
              }
            }
          }
        },
        "summary": "Informa se o processo da API está vivo.",
        "tags": [
          "saude"
        ]
      }
    },
    "/api/v1/saude/pronto": {
      "get": {
        "operationId": "verificarAplicacaoPronta",
