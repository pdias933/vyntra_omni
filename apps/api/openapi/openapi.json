  "info": {
    "title": "API Vyntra Omnichannel",
    "description": "Contrato público e versionado do Omnichannel V1.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ErroCanonicoDto": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "example": "RECURSO_NAO_ENCONTRADO"
          },
          "mensagem": {
            "type": "string",
            "example": "O recurso solicitado não foi encontrado."
          },
          "correlacao_id": {
            "type": "string",
            "example": "7fe3cc48-98bc-4b36-9fe7-36de7c1ac882"
          }
        },
        "required": [
          "codigo",
          "mensagem",
          "correlacao_id"
        ]
      },
      "InformacoesApiDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "Vyntra Omnichannel"
          },
          "versao_api": {
            "type": "string",
            "example": "v1"
          }
        },
        "required": [
          "nome",
          "versao_api"
        ]
      },
      "EstadoSaudeDto": {
        "type": "object",
        "properties": {
          "estado": {
            "type": "string",
            "enum": [
              "VIVO",
              "PRONTO"
            ],
            "example": "PRONTO"
          }
        },
        "required": [
          "estado"
        ]
      }
    }
  }
}
