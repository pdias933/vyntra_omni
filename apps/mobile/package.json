{
  "name": "@vyntra/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "android": "node scripts/executar-expo.mjs run:android",
    "build": "node scripts/executar-expo.mjs export --platform ios --output-dir dist/ios && node scripts/executar-expo.mjs export --platform android --output-dir dist/android",
    "dev": "node scripts/executar-expo.mjs start --dev-client",
    "ios": "node scripts/executar-expo.mjs run:ios",
    "lint": "eslint . --max-warnings 0",
    "start": "node scripts/executar-expo.mjs start --dev-client",
    "typecheck": "tsc --noEmit",
    "verificar:expo": "node scripts/executar-expo.mjs install --check"
  },
  "dependencies": {
    "expo": "~57.0.18",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-secure-store": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@vyntra/eslint-config": "workspace:*",
    "@vyntra/typescript-config": "workspace:*",
    "eslint": "10.9.1",
    "typescript": "~6.0.3"
  }
}
