{
  "name": "@vyntra/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "android": "node scripts/executar-expo.mjs run:android",
    "build": "node scripts/executar-expo.mjs export --platform ios --output-dir dist/ios && node scripts/executar-expo.mjs export --platform android --output-dir dist/android",
    "dev": "node scripts/executar-expo.mjs start --dev-client",
    "ios": "node scripts/executar-expo.mjs run:ios",
    "lint": "eslint . --max-warnings 0",
    "start": "node scripts/executar-expo.mjs start --dev-client",
    "typecheck": "tsc --noEmit",
    "verificar:expo": "node scripts/executar-expo.mjs install --check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0",
    "@react-navigation/bottom-tabs": "7.18.18",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "@vyntra/api-client": "workspace:*",
    "expo": "~57.0.19",
    "expo-camera": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-haptics": "~57.0.2",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.16",
    "expo-secure-store": "~57.0.3",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@vyntra/eslint-config": "workspace:*",
    "@vyntra/typescript-config": "workspace:*",
    "eslint": "10.9.1",
    "typescript": "~6.0.3"
  }
}
