{
  "expo": {
    "name": "Vyntra Omni",
    "slug": "vyntra-omni",
    "scheme": "vyntraomni",
    "version": "0.0.0",
    "plugins": [
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F6F8",
          "dark": { "backgroundColor": "#111318" }
        }
      ],
      "expo-camera",
      "expo-notifications",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita que a Vyntra Omni use o Face ID para desbloquear seu atendimento."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ]
    ],
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "br.com.up100.vyntraomni",
      "supportsTablet": false
    },
    "android": {
      "package": "br.com.up100.vyntraomni",
      "predictiveBackGestureEnabled": true
    }
  }
}
