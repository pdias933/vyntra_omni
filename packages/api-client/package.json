{
  "name": "@vyntra/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gerar": "openapi-ts -i ../../apps/api/openapi/openapi.json -o src/gerado -c @hey-api/client-fetch -p @hey-api/typescript @hey-api/sdk",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@vyntra/eslint-config": "workspace:*",
    "@vyntra/typescript-config": "workspace:*",
    "eslint": "10.9.1",
    "typescript": "6.0.3"
  }
}
