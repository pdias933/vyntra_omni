[Unit]
Description=Backup cifrado Vyntra staging
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/vyntra/current
EnvironmentFile=/etc/vyntra/backup-staging.env
ExecStart=/usr/bin/env node scripts/backup-staging.mjs
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vyntra /mnt/vyntra-backups
UMask=0077
