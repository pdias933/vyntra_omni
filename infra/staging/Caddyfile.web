{
	admin off
	auto_https off
}

http://:8080 {
	root * /srv
	encode zstd gzip

	@ativos path /assets/*
	header @ativos Cache-Control "public, max-age=31536000, immutable"

	route {
		try_files {path} /index.html
		header /index.html Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}
}
